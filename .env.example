# Copy to .env and adjust for local development

# Django
SECRET_KEY=change-me-in-development-only
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL + pgvector via Docker Compose)
DATABASE_URL=postgresql://notcery:notcery@localhost:5432/notcery

# Redis
REDIS_URL=redis://localhost:6379/0

# Google OAuth (see docs/06-kimlik-google-dil-tema.md)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# JWT (placeholders — tune when auth layer is implemented)
JWT_SIGNING_KEY=change-me-jwt-signing-key
JWT_ALGORITHM=RS256
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_ISSUER=notcery
JWT_AUDIENCE=notcery-api

# MinIO (S3-compatible)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_S3_ENDPOINT_URL=http://localhost:9000
AWS_STORAGE_BUCKET_NAME=notcery

# Celery (when enabled)
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Indexer / RAG (Faz 4)
# mock = deterministic local embeddings; gemini = production; auto = gemini if GEMINI_API_KEY set
INDEXER_EMBEDDING_BACKEND=mock
INDEXER_MIN_SIMILARITY=0.35
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# AI orchestration (Faz 5)
# mock = deterministic responses for dev/CI; gemini = production; auto = gemini if GEMINI_API_KEY set
AI_BACKEND=mock
GEMINI_PLAN_MODEL=models/gemini-2.0-flash
GEMINI_CHAT_MODEL=models/gemini-2.0-flash

# Observability (Faz 6)
STRUCTURED_LOGGING=false
LOG_LEVEL=INFO
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# Rate limits (DRF throttle scopes)
RATE_LIMIT_PLAN_GENERATE=10/day
RATE_LIMIT_CHAT_MESSAGE=100/day

# Billing / Stripe (Faz 7)
BILLING_ENFORCE_QUOTAS=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:5173/billing/success
STRIPE_CHECKOUT_CANCEL_URL=http://localhost:5173/billing/cancel

# Optional: Mailpit (start with: docker compose -f infra/docker-compose.yml --profile mail up -d)
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USE_TLS=false
