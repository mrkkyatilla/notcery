[Unit]
Description=Notcery Django (gunicorn)
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
User=root
WorkingDirectory=/var/www/notcery/backend
EnvironmentFile=/var/www/notcery/.env
Environment=DJANGO_SETTINGS_MODULE=config.settings.production
ExecStart=/var/www/notcery/backend/.venv/bin/gunicorn config.wsgi:application \
    --bind 127.0.0.1:8000 \
    --workers 2 \
    --timeout 120 \
    --access-logfile - \
    --error-logfile -
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
