# /var/www/notcery/.env — production (note.wrupup.com)

SECRET_KEY=CHANGE_ME
DEBUG=false
ALLOWED_HOSTS=note.wrupup.com,31.57.108.145,127.0.0.1,localhost
DJANGO_SETTINGS_MODULE=config.settings.production

CORS_ALLOWED_ORIGINS=https://note.wrupup.com
CSRF_TRUSTED_ORIGINS=https://note.wrupup.com
# false when Cloudflare/nginx handle HTTPS (avoids 301 on internal HTTP to gunicorn)
SECURE_SSL_REDIRECT=false

# Host port 5433 when using docker-compose.prod.yml (system postgres often uses 5432)
POSTGRES_HOST_PORT=5433
DATABASE_URL=postgresql://notcery:CHANGE_DB_PASSWORD@127.0.0.1:5433/notcery
REDIS_HOST_PORT=6380
REDIS_URL=redis://127.0.0.1:6380/0

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

JWT_SIGNING_KEY=CHANGE_ME
JWT_ALGORITHM=RS256
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_ISSUER=notcery
JWT_AUDIENCE=notcery-api

# MinIO (sadece docker minio servisi — Storj kullanıyorsanız gerekmez, bkz. env-aciklama.md)
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME
# Django/boto3 — MinIO'da MINIO_ROOT_* ile AYNI; Storj'da console S3 credentials
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_S3_ENDPOINT_URL=http://127.0.0.1:9000
AWS_S3_REGION_NAME=us-east-1
AWS_STORAGE_BUCKET_NAME=notcery

CELERY_BROKER_URL=redis://127.0.0.1:6380/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6380/2

INDEXER_EMBEDDING_BACKEND=auto
GEMINI_API_KEY=
AI_BACKEND=auto

STRUCTURED_LOGGING=false
LOG_LEVEL=INFO
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_CHECKOUT_SUCCESS_URL=https://note.wrupup.com/billing/success
STRIPE_CHECKOUT_CANCEL_URL=https://note.wrupup.com/billing/cancel

# Frontend build (deploy.sh)
VITE_API_URL=https://note.wrupup.com/api/v1
VITE_GOOGLE_CLIENT_ID=

POSTGRES_USER=notcery
POSTGRES_PASSWORD=CHANGE_DB_PASSWORD
POSTGRES_DB=notcery
